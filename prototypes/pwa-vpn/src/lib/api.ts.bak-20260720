/**
 * AUDIT-C2: API client for Go backend.
 * Replaces direct Nostr relay connections with Go backend API calls.
 */

const API_BASE = (import.meta as any).env?.VITE_API_URL || 'http://localhost:8080';

interface ApiResponse<T = any> {
  data?: T;
  error?: string;
  status: number;
}

async function request<T>(path: string, options: RequestInit = {}): Promise<ApiResponse<T>> {
  try {
    const resp = await fetch(`${API_BASE}${path}`, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        ...(options.headers || {}),
      },
      credentials: 'include',
    });

    const data = await resp.json().catch(() => null);
    return { data, status: resp.status, error: resp.ok ? undefined : data?.error || resp.statusText };
  } catch (e: any) {
    return { status: 0, error: e.message };
  }
}

/** WebSocket connection to Go backend (replaces Nostr relay). */
export function connectWebSocket(token: string, onMessage: (msg: any) => void): WebSocket {
  const wsUrl = API_BASE.replace('http', 'ws') + `/api/v1/chat/ws?token=${encodeURIComponent(token)}`;
  const ws = new WebSocket(wsUrl);

  ws.onmessage = (event) => {
    try {
      const msg = JSON.parse(event.data);
      onMessage(msg);
    } catch {
      onMessage({ type: 'raw', data: event.data });
    }
  };

  return ws;
}

/** Chat API */
export const chatApi = {
  // Send direct message
  sendDM: (to: string, content: string) =>
    request('/api/v1/chat/dm', { method: 'POST', body: JSON.stringify({ to, content }) }),

  // Send typing indicator
  sendTyping: (to: string) =>
    request('/api/v1/chat/typing', { method: 'POST', body: JSON.stringify({ to }) }),

  // Send group message
  sendGroupMessage: (groupId: string, content: string) =>
    request('/api/v1/chat/group', { method: 'POST', body: JSON.stringify({ groupId, content }) }),

  // Get online users
  getOnline: () => request<string[]>('/api/v1/chat/online'),

  // Get message history
  getHistory: (peerId: string, limit = 50) =>
    request(`/api/v1/chat/history?peer=${peerId}&limit=${limit}`),
};

/** Auth API */
export const authApi = {
  login: (pubkey: string, signature: string) =>
    request('/api/v1/auth/login', { method: 'POST', body: JSON.stringify({ pubkey, signature }) }),
  
  me: () => request('/api/v1/auth/me'),
};

/** Content API */
export const contentApi = {
  list: () => request('/api/v1/content/list'),
  upload: (file: File) => {
    const formData = new FormData();
    formData.append('file', file);
    return request('/api/v1/content/upload', { method: 'POST', body: formData });
  },
  download: (id: string) => `${API_BASE}/api/v1/content/${id}/download`,
};

/** Social API */
export const socialApi = {
  getFeed: (limit = 20) => request(`/api/v1/social/feed?limit=${limit}`),
  publish: (content: string) =>
    request('/api/v1/social/publish', { method: 'POST', body: JSON.stringify({ content }) }),
  getProfile: (pubkey: string) => request(`/api/v1/social/profile/${pubkey}`),
};

export { API_BASE };
